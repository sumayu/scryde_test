{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(css|js|img|fonts|assets)/(.*)",
      "destination": "/$1/$2"
    },
    {
      "source": "/(.*).(png|jpg|jpeg|svg|webp|ico|json)",
      "destination": "/$1.$2"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
